{#
/**
 * @file movie.html.twig
 * Default theme implementation to present Movie data.
 */
#}

<div class="card mb-3">
  <div class="card-body">
    <h5 class="card-title">{{title}}</h5>
    <h6 class="card-subtitle text-muted">{{year}}</h6>
  </div>
  <img style="width: 100%; display: block;" src="{{ image }}">
  <div class="card-body">
    <p class="card-text">{{description}}</p>
  </div>

  <div class="card-body">
    <a href="/" class="card-link">&lt; Back home</a>
  </div>
</div>