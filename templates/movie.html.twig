{#
/**
 * @file movie.html.twig
 * Default theme implementation to present Movie data.
 */
#}

    <div class="card-block col-md-4 col-lg-4">
      <img class="bd-placeholder-img card-img-top" width="100%" height="225" src="{{ image }}">
    </div>
    <div class="card-block col-md-4 col-lg-4">
      <div class="card border-light" style="margin: 0px 7px 0px 7px;">
        <div class="card-body">
          <h3><a href="/movie/{{ id }}" class="card-link">{{ title }} <small class="text-muted">({{ year }})</small></a></h3>
          <span class="badge badge-pill badge-secondary">{{ rating }}</span><span class="badge badge-secondary">{{runtime}}</span>
          <p class="card-text">{{ description }}</p>
          <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted">ID: {{ id }}</small>
          </div>
        </div>
      </div>
    </div>