{#
/**
 * @file movie.html.twig
 * Default theme implementation to present Movie data.
 */
#}

    <div class="card-block">
      <div class="card border-light" style="margin: 0px 7px 0px 7px;">
        <img class="bd-placeholder-img card-img-top" width="100%" height="225" src="{{ movie.image }}">
        <div class="card-body">
          <h3><a href="/movie/{{ movie.id }}" class="card-link">{{ movie.title }} <small class="text-muted">({{ movie.year }})</small></a></h3>
          <span class="badge badge-pill badge-secondary">{{ movie.rating }}</span><span class="badge badge-secondary">{{movie.runtime}}</span>
          <p class="card-text">{{ movie.description }}</p>
          <div class="d-flex justify-content-between align-items-center">
          <small class="text-muted">ID: {{ movie.id }}</small>
          </div>
        </div>
      </div>
    </div>